rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Documents & User-specific Subcollections
    match /users/{userId} {
      // Authenticated users can only read and write their own profile
      allow read, write: if isOwner(userId);

      // Daily Wellbeing Check-ins stored under users/{userId}/checkins/{checkinId}
      // Strictly secured: only the authenticated owner can read or write their own check-ins
      match /checkins/{checkinId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-level check-ins collection (if accessed, must match authenticated user's UID)
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Confidential Counselor Support Queue & Messages
    match /counselor_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /support_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
