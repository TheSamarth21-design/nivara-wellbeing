rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCounselor() {
      return isAuthenticated() && (
        (request.auth.token.role in ['counselor', 'doctor', 'admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['counselor', 'doctor', 'admin'])
      );
    }

    // User Profile Documents & User-specific Subcollections
    match /users/{userId} {
      // Authenticated users can read/write their own profile; counselors can read assigned/student profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCounselor());
      allow write: if isOwner(userId);

      // Daily Wellbeing Check-ins stored under users/{userId}/checkins/{checkinId}
      // Strictly secured: owner has full access (read, create, update, delete)
      match /checkins/{checkinId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Alternative subcollection path users/{userId}/wellbeingCheckins/{checkinId}
      match /wellbeingCheckins/{checkinId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Top-level check-ins collection (if accessed, must match authenticated user's UID)
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
    }

    // Top-level wellbeingCheckins collection (if accessed, must match authenticated user's UID)
    match /wellbeingCheckins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
    }

    // Confidential Counselor Support Queue & Messages
    match /counselor_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /support_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // SOS Emergency Support Requests (Live Audio / Video Sessions)
    match /supportRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.counselorId == request.auth.uid ||
        resource.data.status in ['waiting', 'pending'] ||
        isCounselor()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.status in ['waiting', 'pending'] ||
        resource.data.counselorId == request.auth.uid ||
        request.resource.data.counselorId == request.auth.uid ||
        isCounselor()
      );

      allow delete: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }
  }
}
