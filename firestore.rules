rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // User Profile Documents (RBAC)
    match /users/{userId} {
      // Any authenticated user can read their own profile document
      allow read: if isOwner(userId) || hasRole('counselor');

      // Creation is allowed upon initial registration with a valid role
      allow create: if isOwner(userId) 
        && request.resource.data.role in ['student', 'teacher', 'counselor']
        && request.resource.data.email == request.auth.token.email;

      // Updating a user profile cannot arbitrarily modify the role from the frontend
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);
    }

    // Student Wellbeing Check-ins & Reflections
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('counselor')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Confidential Counselor Support Queue
    match /counselor_requests/{requestId} {
      // Students can read/create their own requests; Counselors can view/manage all queue items
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('counselor')
      );
      allow create: if isAuthenticated() && hasRole('student');
      allow update: if isAuthenticated() && hasRole('counselor');
      allow delete: if false; // Audit preservation
    }

    // Support Messages
    match /support_messages/{messageId} {
      allow read, create: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasRole('counselor')
      );
    }

    // Default Deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
