rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Documents (RBAC)
    match /users/{userId} {
      // Authenticated users can read and write their own profile
      allow read, write: if isOwner(userId);
    }

    // Student Wellbeing Check-ins & Reflections
    match /checkins/{checkinId} {
      allow read, write: if isAuthenticated();
    }

    // Confidential Counselor Support Queue & Messages
    match /counselor_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /support_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // All authenticated users have access to app data
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
