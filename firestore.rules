rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCounselor() {
      return isAuthenticated() && (
        (request.auth.token.role in ['counselor', 'doctor', 'admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['counselor', 'doctor', 'admin'])
      );
    }

    // User Profile Documents & User-specific Subcollections
    match /users/{userId} {
      // Authenticated users can read/write their own profile; counselors can read assigned/student profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCounselor());
      allow write: if isOwner(userId);

      // Daily Wellbeing Check-ins stored under users/{userId}/checkins/{checkinId}
      // Strictly secured: owner has full access; counselors can review for support
      match /checkins/{checkinId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isCounselor());
        allow write: if isOwner(userId);
      }
    }

    // Top-level check-ins collection (if accessed, must match authenticated user's UID or counselor)
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCounselor());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Confidential Counselor Support Queue & Messages
    match /counselor_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /support_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // SOS Emergency Support Requests (Live Audio / Video Sessions)
    match /supportRequests/{requestId} {
      // Read access:
      // - The requesting student can read their own request
      // - The assigned counselor can read the request
      // - Any authenticated user / counselor can read requests in 'waiting' or 'pending' queue
      // - Verified counselors can read requests
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.counselorId == request.auth.uid ||
        resource.data.status in ['waiting', 'pending'] ||
        isCounselor()
      );

      // Create access:
      // - Authenticated student creates a request where studentId matches their auth UID
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid
      );

      // Update access:
      // - Student owner can update their request (cancel, complete, mark active)
      // - Counselors can update requests in 'waiting' / 'pending' status (accept or decline)
      // - Assigned counselor can update their active session
      // - User assigning themselves as counselor (accepting)
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.status in ['waiting', 'pending'] ||
        resource.data.counselorId == request.auth.uid ||
        request.resource.data.counselorId == request.auth.uid ||
        isCounselor()
      );

      // Delete access:
      // - Only the student owner can delete their request
      allow delete: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }
  }
}
